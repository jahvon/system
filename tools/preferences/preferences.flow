# yaml-language-server: $schema=https://flowexec.io/schemas/flowfile_schema.json

visibility: public
namespace: preferences
tags: [preferences, macos, iterm]
description: macOS app preferences

executables:
  - verb: install
    name: iterm
    description: |
      Install the Everforest iTerm2 profiles (shell, flow library, k9s) as Dynamic Profiles,
      with ${HOME} in profiles.json replaced by this machine's home directory.
      iTerm reloads them live, so this is safe while iTerm is running.
    exec:
      dir: //tools/preferences/iterm
      cmd: |
        set -e
        if [ "$(uname)" != "Darwin" ]; then
          echo "iTerm profiles are macOS-only; skipping"
          exit 0
        fi
        # iTerm's parser rejects NaN/Infinity, which lenient tools like jq accept
        python3 -c 'import json,sys; json.load(open("profiles.json"), parse_constant=lambda c: sys.exit("profiles.json: invalid JSON constant " + c))'
        DEST="$HOME/Library/Application Support/iTerm2/DynamicProfiles"
        mkdir -p "$DEST"
        # A rendered copy, not a symlink: iTerm only reloads when a real file here changes, and
        # paths are stored as ${HOME} because iTerm doesn't expand ~ or variables itself
        sed "s|\${HOME}|$HOME|g" profiles.json > "$DEST/system-everforest.json"
        echo "[DONE] Installed $(jq '.Profiles | length' profiles.json) iTerm profiles to $DEST"
