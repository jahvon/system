# yaml-language-server: $schema=https://flowexec.io/schemas/flowfile_schema.json

visibility: public
namespace: dotfiles
tags: [dotfiles, shell, zsh, git]
description: Manage dotfiles and shell configuration

imports:
  - git-setup.sh

executables:
  # -- ZSH Setup --

  - verb: install
    name: zsh-plugins
    description: Install powerlevel10k, zsh-autosuggestions, and zsh-syntax-highlighting
    exec:
      cmd: |
        set -e
        if [ "$(uname)" = "Darwin" ]; then
          brew install powerlevel10k zsh-autosuggestions zsh-syntax-highlighting
          # compinit refuses group-writable fpath dirs, which Homebrew creates by default
          chmod go-w "$(brew --prefix)/share" "$(brew --prefix)/share/zsh" "$(brew --prefix)/share/zsh/site-functions"
        else
          mkdir -p "$HOME/.zsh/plugins"
          for repo in romkatv/powerlevel10k zsh-users/zsh-autosuggestions zsh-users/zsh-syntax-highlighting; do
            dir="$HOME/.zsh/plugins/${repo#*/}"
            # Public repos: skip the global https->ssh rewrite so this works before an SSH key is on GitHub
            if [ -d "$dir" ]; then
              GIT_CONFIG_GLOBAL=/dev/null git -C "$dir" pull --ff-only
            else
              GIT_CONFIG_GLOBAL=/dev/null git clone --depth=1 "https://github.com/$repo.git" "$dir"
            fi
          done
        fi
        echo "[DONE] Zsh plugins installed"

  - verb: install
    name: mise
    description: Install mise and the global tool versions from ~/.config/mise/config.toml
    exec:
      cmd: |
        set -e
        export PATH="$HOME/.local/bin:$PATH"
        if ! command -v mise > /dev/null; then
          if [ "$(uname)" = "Darwin" ]; then
            brew install mise
          else
            curl -fsSL https://mise.run | sh
          fi
        fi
        mise install
        echo "[DONE] mise tools installed"

  # -- Individual Dotfile Installers --

  - verb: install
    name: gitignore
    description: Install global .gitignore_global
    exec:
      dir: //tools/dotfiles
      cmd: |
        echo "Installing .gitignore_global..."
        cp templates/gitignore_global $HOME/.gitignore_global
        echo "[DONE] .gitignore_global installed"

  - verb: install
    name: gitmessage
    description: Install .gitmessage commit template
    exec:
      dir: //tools/dotfiles
      cmd: |
        echo "Installing .gitmessage..."
        cp templates/gitmessage $HOME/.gitmessage
        echo "[DONE] .gitmessage installed"

  - verb: install
    name: zsh-config
    description: |
      Symlink .zshrc, .zshenv, .zprofile, .p10k.zsh, and the mise config to the templates in this repo.

      Existing regular files are moved to ~/.dotfiles-backup/<timestamp>/ first. Because the files are
      links, anything an installer appends shows up as a diff in this repo.
    exec:
      dir: //tools/dotfiles
      cmd: |
        set -e
        TEMPLATES="$(pwd)/templates"
        BACKUP_DIR="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"

        link() {
          src="$TEMPLATES/$1"
          dest="$2"
          mkdir -p "$(dirname "$dest")"
          if [ -e "$dest" ] && [ ! -L "$dest" ]; then
            mkdir -p "$BACKUP_DIR"
            mv "$dest" "$BACKUP_DIR/"
            echo "Backed up $dest"
          fi
          ln -sfn "$src" "$dest"
          echo "Linked $dest -> $src"
        }

        link zshrc "$HOME/.zshrc"
        link zshenv "$HOME/.zshenv"
        link zprofile "$HOME/.zprofile"
        link path.zsh "$HOME/.zsh/path.zsh"
        link p10k.zsh "$HOME/.p10k.zsh"
        link mise.toml "$HOME/.config/mise/config.toml"

        # rvm was the only thing in .zlogin; mise manages ruby now
        if [ -f "$HOME/.zlogin" ] && [ ! -L "$HOME/.zlogin" ]; then
          mkdir -p "$BACKUP_DIR"
          mv "$HOME/.zlogin" "$BACKUP_DIR/"
          echo "Moved ~/.zlogin to $BACKUP_DIR"
        fi

        mkdir -p "$HOME/.zsh/completions"
        touch "$HOME/.zshrc.local" "$HOME/.zshenv.local"

        # Skips login(1)'s "Last login" system log scan on every new terminal
        touch "$HOME/.hushlogin"

        echo "[DONE] Zsh configuration linked"

  # -- Main Apply Executables --

  - verb: apply
    name: dotfiles
    aliases: [setup-dotfiles]
    description: |
      Apply all dotfiles - installs zsh plugins, mise tools, and all dotfile configurations.

      This is the main dotfile setup command for new systems.
    serial:
      failFast: true
      execs:
        - cmd: echo "Setting up dotfiles with Flow..."

        - ref: install dotfiles:zsh-plugins

        - ref: install dotfiles:gitignore

        - ref: install dotfiles:gitmessage

        - ref: install dotfiles:zsh-config

        - ref: install dotfiles:mise

        - cmd: |
            echo ""
            echo "[DONE] Dotfiles Applied Successfully"
            echo "====================================="
            echo ""
            echo "Next steps:"
            echo "  1. If using zsh for the first time: chsh -s \$(which zsh)"
            echo "  2. Restart your shell or run: source ~/.zshrc"
            echo "  3. Edit local overrides in ~/.zshrc.local or ~/.zshenv.local"
            echo ""

  - verb: update
    name: dotfiles
    description: |
      Update existing dotfiles from templates (preserves local overrides).

      Use this to pull the latest dotfile changes from the repo.
    serial:
      execs:
        - cmd: echo "Updating dotfiles..."

        - ref: install dotfiles:gitignore
        - ref: install dotfiles:gitmessage
        - ref: install dotfiles:zsh-config

        - cmd: |
            echo ""
            echo "[DONE] Dotfiles updated"
            echo "[INFO] .gitconfig was NOT updated (contains personal info)"
            echo "[INFO] Restart your shell to apply changes: source ~/.zshrc"

  - verb: show
    description: Show which dotfiles are managed by Flow
    exec:
      cmd: |
        echo "Flow-Managed Dotfiles"
        echo "====================="
        echo ""
        echo "Main Configuration Files:"
        ls -lh ~/.gitconfig ~/.gitignore_global ~/.gitmessage 2>/dev/null || true
        echo ""
        echo "Linked Configuration (edit in this repo):"
        ls -l ~/.zshrc ~/.zshenv ~/.zprofile ~/.zsh/path.zsh ~/.p10k.zsh ~/.config/mise/config.toml 2>/dev/null || true
        echo ""
        echo "Local Overrides (not managed by Flow):"
        ls -lh ~/.gitconfig.local ~/.zshrc.local ~/.zshenv.local 2>/dev/null || true
