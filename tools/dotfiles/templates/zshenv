# Set cache root based on OS
if [[ "$OSTYPE" == "darwin"* ]]; then
  export CACHE_ROOT="$HOME/Library/Caches"
else
  CACHE_HOME=${XDG_CONFIG_HOME:-$HOME}
  export CACHE_ROOT="$CACHE_HOME/.cache"
fi

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export EDITOR='nvim'
export VISUAL='nvim'

export WORKSPACES="$HOME/workspaces"
export GITHUB="$WORKSPACES/github.com"
export JAHVON="$WORKSPACES/github.com/jahvon"
export FLOWEXEC="$WORKSPACES/github.com/flowexec"
export SANDBOX="$WORKSPACES/sandbox"
export TOOLS="$WORKSPACES/tools"
export DOWNLOADS="$HOME/Downloads"

export OBSIDIAN_VAULT="$HOME/Documents/Knowledge Library"

[[ -f ~/.flowkey ]] && export FLOW_VAULT_KEY=$(<~/.flowkey)

# Programming Languages (versions managed by mise; see ~/.config/mise/config.toml)
export GOPATH="$HOME/go"
export GOBIN="$GOPATH/bin"
export MISE_NODE_COREPACK=true

source ~/.zsh/path.zsh

# Local config
[[ -f ~/.zshenv.local ]] && source ~/.zshenv.local
