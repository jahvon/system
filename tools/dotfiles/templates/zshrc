# Keep windsurf agent terminals free of prompt/plugin setup
if [[ "$WINDSURF_CASCADE_TERMINAL" == "1" ]]; then
  exec bash
fi

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Plugins come from Homebrew on macOS and ~/.zsh/plugins elsewhere (see dotfiles:zsh-plugins)
if [[ -n "$HOMEBREW_PREFIX" && -d "$HOMEBREW_PREFIX/share/powerlevel10k" ]]; then
  ZSH_PLUGINS="$HOMEBREW_PREFIX/share"
else
  ZSH_PLUGINS="$HOME/.zsh/plugins"
fi

# -- Options --
setopt auto_cd auto_pushd pushd_ignore_dups interactive_comments
setopt extended_history share_history hist_ignore_dups hist_ignore_space hist_verify

HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000

# -- Completion --
fpath=(~/.zsh/completions ${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/share/zsh/site-functions} $fpath)

autoload -Uz compinit
_zcompdump="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"
[[ -d "${_zcompdump:h}" ]] || command mkdir -p "${_zcompdump:h}"
# Full security check at most once a day; otherwise trust the cached dump
_stale=("$_zcompdump"(N.mh+24))
if [[ ! -s "$_zcompdump" || -n "$_stale" ]]; then
  compinit -d "$_zcompdump"
else
  compinit -C -d "$_zcompdump"
fi
[[ "$_zcompdump.zwc" -nt "$_zcompdump" ]] || zcompile "$_zcompdump" &!
unset _zcompdump _stale

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# -- Key bindings --
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^[[1;3C' forward-word
bindkey '^[[1;3D' backward-word

# -- Prompt and plugins --
source "$ZSH_PLUGINS/powerlevel10k/powerlevel10k.zsh-theme"
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

source "$ZSH_PLUGINS/zsh-autosuggestions/zsh-autosuggestions.zsh"

# -- Aliases --
if [[ "$OSTYPE" == "darwin"* ]]; then
  alias ls="ls -G"
else
  alias ls="ls --color=auto"
fi
alias ll="ls -al"
alias mkdir="mkdir -p"
alias e="$EDITOR"
alias v="$VISUAL"
alias c="clear"
alias h="history"

alias ozshrc="$EDITOR ~/.zshrc.local"
alias ozshenv="$EDITOR ~/.zshenv.local"

### Navigating
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."

# Named dirs work anywhere in a path (cd ~mochi/desktop) and shorten the prompt
hash -d ws="$WORKSPACES"
hash -d mochi="$FLOWEXEC/mochi"
hash -d flow="$FLOWEXEC/flow"
hash -d ico="$JAHVON/inference-cluster-ops"
hash -d kube="$JAHVON/kube"
hash -d system="$JAHVON/system"
hash -d notes="$OBSIDIAN_VAULT"

# `cd <repo>` from anywhere for repos in these parents
cdpath=(. "$FLOWEXEC" "$JAHVON" "$GITHUB/klipster-eng" "$WORKSPACES")

# ws [query]: jump to a repo by exact name, or pick one with fzf (no args lists every repo)
# Listed in priority order: an exact name match picks the first hit (flowexec/flow over jahvon/flow)
_ws_repos() {
  setopt local_options extended_glob
  print -l "$FLOWEXEC"/*(N/) "$JAHVON"/*(N/) "$WORKSPACES"/github.com/^(flowexec|jahvon)/*(N/) \
    "$WORKSPACES"/sandbox/*(N/) "$WORKSPACES"/git.malik.haus/*/*(N/)
}
ws() {
  local -a repos=(${(f)"$(_ws_repos)"})
  local -a exact=(${(M)repos:#*/$1})
  if [[ -n "$1" && ${#exact} -gt 0 ]]; then
    cd "$exact[1]"
    return
  fi
  local dir
  dir=$(print -l ${repos#$WORKSPACES/} | fzf --height=40% --reverse --select-1 --exit-0 --query="$1") || return
  cd "$WORKSPACES/$dir"
}
_ws() { local -a names=(${(f)"$(_ws_repos)"}); compadd -- ${names:t}; }
compdef _ws ws

### Flow and Mochi
alias f="flow"
alias lib="flow browse"
alias devflow="$FLOWEXEC/flow/.bin/flow"
alias devmochi="$FLOWEXEC/mochi/bin/mochi"
compdef _flow f devflow 2>/dev/null
compdef _mochi devmochi 2>/dev/null

### Kubernetes
alias k="kubectl"

### Print each PATH entry on a separate line
alias path='echo -e ${PATH//:/\\n}'

# -- Kubeconfig --
_kubeconfigs=(~/.kube/configs/*.y(a|)ml(N) ~/.kube/config(N))
(( ${#_kubeconfigs} )) && export KUBECONFIG="${(j.:.)_kubeconfigs}"
unset _kubeconfigs

# -- Local config --
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# Must be sourced last so it wraps every widget defined above
source "$ZSH_PLUGINS/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
