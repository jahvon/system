# yaml-language-server: $schema=https://flowexec.io/schemas/flowfile_schema.json

visibility: public
namespace: workbox
tags: [server, remote]
description: One-click actions for workbox, the k3s agent node

executables:
  - verb: check
    name: status
    tags: [read-only]
    description: Show workbox's uptime, load, disk, pending reboot, tool versions, tmux sessions, and workspaces. Read-only.
    exec:
      dir: //tools/servers
      cmd: ./bin/status.sh workbox

  - verb: connect
    name: shell
    description: Open a shell on workbox in iTerm. Agents get the command printed instead.
    exec:
      dir: //tools/servers
      cmd: ./bin/shell.sh workbox
