# yaml-language-server: $schema=https://flowexec.io/schemas/flowfile_schema.json

visibility: public
namespace: devbox
tags: [server, remote]
description: One-click actions for devbox (alias server01), the k3s control plane and Ubuntu desktop

executables:
  - verb: check
    name: status
    tags: [read-only]
    description: Show devbox's uptime, load, disk, pending reboot, tool versions, tmux sessions, and workspaces. Read-only.
    exec:
      dir: //tools/servers
      cmd: ./bin/status.sh devbox

  - verb: connect
    name: shell
    description: Open a shell on devbox in iTerm. Agents get the command printed instead.
    exec:
      dir: //tools/servers
      cmd: ./bin/shell.sh devbox

  - verb: open
    name: desktop
    description: Open devbox's Ubuntu desktop with FreeRDP in iTerm, which asks for the RDP login. Leave the domain blank.
    exec:
      dir: //tools/servers
      cmd: ./bin/desktop.sh devbox

  - verb: connect
    name: claude
    description: Attach to the first Remote Control server on devbox in iTerm. Detach with Ctrl-b d; it keeps running.
    exec:
      dir: //tools/servers
      cmd: ./bin/claude.sh connect devbox

  - verb: show
    name: claude
    tags: [read-only]
    description: Show whether devbox's Remote Control servers are running, and their screens. Read-only.
    exec:
      dir: //tools/servers
      cmd: ./bin/claude.sh status devbox

  - verb: start
    name: claude
    description: Start or confirm devbox's Remote Control servers, one per workspace, where you can start new Claude sessions. Safe to re-run.
    exec:
      dir: //tools/servers
      cmd: ./bin/claude.sh start devbox
