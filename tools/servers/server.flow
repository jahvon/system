# yaml-language-server: $schema=https://flowexec.io/schemas/flowfile_schema.json

visibility: public
namespace: server
tags: [server, remote]
description: Registry of machines and clusters, and how this machine connects to them

executables:
  - verb: show
    name: list
    aliases: [servers]
    tags: [read-only]
    description: |
      Print every registered machine as a table: name, kind, address, user, Kubernetes node, aliases, and
      the last result of check server:status. Read-only and offline. Source: tools/servers/inventory.yaml.
    exec:
      dir: //tools/servers
      cmd: ./bin/list.sh

  - verb: check
    name: status
    tags: [read-only]
    description: |
      Show a server's uptime, load, disk, pending reboot, tool versions, tmux sessions, and workspaces:
      `flow check server:status devbox`. Read-only on the server; saves the result to flow's data store
      as server.<name>.status. Exits 1 if unreachable.
    exec:
      dir: //tools/servers
      args:
        - pos: 1
          envKey: SERVER
          required: true
      cmd: ./bin/status.sh "$SERVER"

  - verb: connect
    name: shell
    description: |
      Open a shell on a server in iTerm: `flow connect server:shell devbox`. Agents get the command
      printed instead, and should use run server:command for remote work.
    exec:
      dir: //tools/servers
      args:
        - pos: 1
          envKey: SERVER
          required: true
      cmd: ./bin/shell.sh "$SERVER"

  - verb: run
    name: command
    description: |
      Run one non-interactive command on a server and return its output and exit code:
      `flow run server:command devbox 'uname -a'`. Can change the server, depending on the command.
      For k3s node work, use the k3s: executables in the kube workspace instead.
    exec:
      dir: //tools/servers
      args:
        - pos: 1
          envKey: SERVER
          required: true
        - pos: 2
          envKey: REMOTE_COMMAND
          required: true
      cmd: ./bin/command.sh "$SERVER" "$REMOTE_COMMAND"

  - verb: update
    name: flow
    description: |
      Install this machine's flow version on a server, verifying the release checksum:
      `flow update server:flow devbox`. Changes the server. Safe to re-run.
    exec:
      dir: //tools/servers
      args:
        - pos: 1
          envKey: SERVER
          required: true
      cmd: ./bin/flow-upgrade.sh "$SERVER"

  - verb: show
    name: workspaces
    tags: [read-only]
    description: List the flow workspaces registered on a server, with paths. Read-only.
    exec:
      dir: //tools/servers
      args:
        - pos: 1
          envKey: SERVER
          required: true
      cmd: ./bin/workspaces.sh show "$SERVER"

  - verb: check
    name: workspaces
    tags: [read-only]
    description: |
      Compare a server's registered workspaces with the registry. Read-only. Prints [OK], [MISSING], and
      [EXTRA] lines; exits 1 if any are missing.
    exec:
      dir: //tools/servers
      args:
        - pos: 1
          envKey: SERVER
          required: true
      cmd: ./bin/workspaces.sh check "$SERVER"

  - verb: update
    name: workspaces
    description: |
      Register a server's missing workspaces from git and refresh existing ones:
      `flow update server:workspaces devbox`. Changes the server, but never pulls over local changes.
      Needs flow 2.x; run update server:flow first.
    exec:
      dir: //tools/servers
      args:
        - pos: 1
          envKey: SERVER
          required: true
      cmd: ./bin/workspaces.sh update "$SERVER"

  - verb: open
    name: desktop
    description: |
      Open a server's desktop over RDP with FreeRDP: `flow open server:desktop devbox`. Interactive: opens
      iTerm to ask for the RDP login (leave the domain blank), and agents get the command to hand to the user.
    exec:
      dir: //tools/servers
      args:
        - pos: 1
          envKey: SERVER
          required: true
      cmd: ./bin/desktop.sh "$SERVER"

  - verb: install
    name: desktop
    description: |
      Set up GNOME Desktop Sharing on a server: `flow install server:desktop devbox`. Installs FreeRDP here,
      limits the RDP port to the LAN and tailnet, turns off the screen lock, adds a passwordless keyring, and
      can set a new login. Weakens local security on purpose, for a home server. Safe to re-run. Interactive.
    exec:
      dir: //tools/servers
      args:
        - pos: 1
          envKey: SERVER
          required: true
      cmd: ./bin/desktop-setup.sh "$SERVER"

  - verb: install
    name: claude
    description: |
      Prepare a server for Claude sessions: `flow install server:claude devbox [workspace]`. Clones the session's
      checkout, sets the permission mode to default, installs agent-framework and system skills. Changes the
      server. Safe to re-run. Needs Claude Code already logged in there.
    exec:
      dir: //tools/servers
      args:
        - pos: 1
          envKey: SERVER
          required: true
        - pos: 2
          envKey: WORKSPACE
          default: ""
      cmd: ./bin/claude.sh install "$SERVER" "$WORKSPACE"

  - verb: start
    name: claude
    description: |
      Start a persistent Claude session in tmux, with Remote Control on: `flow start server:claude devbox [workspace]`.
      Resumes the last conversation. Safe to re-run; one session per workspace. Reach it from claude.ai or the mobile app.
    exec:
      dir: //tools/servers
      args:
        - pos: 1
          envKey: SERVER
          required: true
        - pos: 2
          envKey: WORKSPACE
          default: ""
      cmd: ./bin/claude.sh start "$SERVER" "$WORKSPACE"

  - verb: show
    name: claude
    tags: [read-only]
    description: Show whether a server's Claude session is running, and its current screen. Read-only. Exits 1 if not running.
    exec:
      dir: //tools/servers
      args:
        - pos: 1
          envKey: SERVER
          required: true
        - pos: 2
          envKey: WORKSPACE
          default: ""
      cmd: ./bin/claude.sh status "$SERVER" "$WORKSPACE"

  - verb: connect
    name: claude
    description: |
      Attach to a server's Claude session in iTerm. Detach with Ctrl-b d; the session keeps running. Agents get
      the command printed instead, and should use `claude -p -c` in the checkout through run server:command.
    exec:
      dir: //tools/servers
      args:
        - pos: 1
          envKey: SERVER
          required: true
        - pos: 2
          envKey: WORKSPACE
          default: ""
      cmd: ./bin/claude.sh connect "$SERVER" "$WORKSPACE"

  - verb: stop
    name: claude
    description: Stop a server's Claude session by ending its tmux session. Conversation history stays; start resumes it.
    exec:
      dir: //tools/servers
      args:
        - pos: 1
          envKey: SERVER
          required: true
        - pos: 2
          envKey: WORKSPACE
          default: ""
      cmd: ./bin/claude.sh stop "$SERVER" "$WORKSPACE"

  - verb: show
    name: inventory
    tags: [read-only]
    description: Print the whole registry (servers, clusters, network) as JSON for scripts and agents. Read-only and offline.
    exec:
      dir: //tools/servers
      cmd: yq -o=json . inventory.yaml

  - verb: apply
    name: ssh-config
    description: |
      Regenerate ~/.ssh/config.d/servers.conf from the registry, so `ssh <server>` works by name or alias.

      Changes this machine only. Adds an Include to ~/.ssh/config the first time, after backing it up.
      Run after editing inventory.yaml.
    exec:
      dir: //tools/servers
      cmd: ./bin/ssh-config.sh

  - verb: install
    name: ssh-access
    description: |
      Set up passwordless SSH to a server: `flow install server:ssh-access devbox`.

      Creates a "homelab ssh" key in 1Password if missing, writes its public half to ~/.ssh/homelab.pub,
      and authorizes it on the server. Interactive: opens iTerm for 1Password approval and the server's
      password, and agents get the command to hand to the user. Safe to re-run.
    exec:
      dir: //tools/servers
      args:
        - pos: 1
          envKey: SERVER
          required: true
      cmd: ./bin/ssh-access.sh "$SERVER"

  - verb: install
    name: sudoers
    description: |
      Allow routine k3s commands to use sudo without a password on a node: `flow install server:sudoers devbox`.

      Installs files/sudoers-k3s to /etc/sudoers.d/flow-k3s after validating it with visudo, plus the
      files/flow-k3s-upgrade helper that upgrade k3s:node uses. Safe to re-run. Interactive: opens iTerm
      for the sudo password. Reading k3s.yaml grants cluster admin, so this widens what anything
      running as that user can do. Run install server:ssh-access first.
    exec:
      dir: //tools/servers
      args:
        - pos: 1
          envKey: SERVER
          required: true
      cmd: ./bin/sudoers.sh "$SERVER"
