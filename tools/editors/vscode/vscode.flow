visibility: private
tags: [ide]
executables:
  - verb: open
    visibility: public
    name: vscode
    launch:
      args:
        - pos: 1
          envKey: URI
          default: "."
      uri: $URI
      app: "Visual Studio Code"

  - verb: "open"
    name: "workspace"
    launch:
      uri: "$FLOW_WORKSPACE_PATH"
      wait: true
